# Set on the Next.js server only. Do not prefix with NEXT_PUBLIC_.
# Generate a unique random token of >=32 printable characters in a password manager.
MCP_ACCESS_TOKEN=
# Full HTTPS origin of the deployed PamaENV Store (ending in /).
PAMA_ENV_STORE_URL=
# Scoped machine token issued in PamaENV. Never share with MCP clients.
PAMA_ENV_MACHINE_TOKEN=
# Production metadata/connection checks are DISABLED unless explicitly "true".
MCP_ENABLE_PRODUCTION_READS=false

# Optional, disabled by default. Explicit staging-only project -> table -> fields allowlist:
# {"sample":{"orders":["status","total"]}}
# Never enable sensitive fields without reviewing privacy/least-privilege consequences.
MCP_DOCUMENT_READ_POLICY=
