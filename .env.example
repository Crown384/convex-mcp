# Next.js server-only (never NEXT_PUBLIC_*)
AUTH_SITE_URL=
CONVEX_AUTH_SITE_URL=
AUTH_ALLOWED_EMAILS=
PAMA_ENV_STORE_URL=
PAMA_ENV_MACHINE_TOKEN=
MCP_ENABLE_PRODUCTION_READS=false
MCP_DOCUMENT_READ_POLICY=

# Set privately on the separate control-plane Convex deployment:
# AUTH_SITE_URL=<same HTTPS website origin>
# AUTH_ALLOWED_EMAILS=<same comma-separated exact owner emails>
# BETTER_AUTH_SECRET=<at least 32 random characters>
# MAILJET_API_KEY=<private>
# MAILJET_SECRET_KEY=<private>
# MAILJET_FROM_EMAIL=<verified sender>
# Convex CLI deployment credentials are provisioned privately and are never committed.
